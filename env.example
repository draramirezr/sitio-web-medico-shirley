# ============================================
# RECORDATORIOS ANUALES DE CHEQUEO (opt-in)
# ============================================
# Secreto para el cron semanal (Railway Cron / GitHub Actions)
# Ejemplo de llamada:
#   GET https://www.draramirez.com/cron/recordatorios-anuales?key=TU_SECRETO
#   (dry_run=1 solo lista, no envÃ­a)
CRON_SECRET=
# DÃ­as desde la Ãºltima cita completada para el 1.er aviso (~11 meses)
ANNUAL_REMINDER_MIN_DAYS=335
# DÃ­as para el Ãºnico recordatorio extra si no agendÃ³ (~13 meses)
ANNUAL_REMINDER_EXTRA_DAYS=400
# MÃ¡ximo de correos por ejecuciÃ³n
ANNUAL_REMINDER_BATCH_LIMIT=40
# Ciclo: mÃ¡ximo 2 avisos (1.er + extra), luego silencio hasta nueva cita completada

# Recordatorio 24 h antes de cita confirmada (cron diario recomendado ~8:00 a.m. RD)
#   GET https://www.draramirez.com/cron/recordatorios-cita-24h?key=TU_SECRETO
PRE_APPOINTMENT_REMINDER_BATCH_LIMIT=80

# ============================================
# DGII FACTURA ELECTRONICA (Fase A)
# ============================================
# Ambiente: PRUEBAS | CERTIFICACION | PRODUCCION
DGII_AMBIENTE=PRUEBAS
# Carpeta privada para el .p12/.pfx
# En Railway: si hay volume montado, se usa automaticamente
#   $RAILWAY_VOLUME_MOUNT_PATH/dgii_certs
# O fija una ruta explicita, ej.:
# DGII_CERT_DIR=/data/dgii_certs
DGII_CERT_DIR=
# Clave Fernet para cifrar la contrasena del certificado (recomendado)
# Si falta, se deriva de SECRET_KEY
DGII_CERT_SECRET=
# Emitir e-CF al generar factura (1=si, 0=no)
DGII_EMITIR_AUTO=1
DGII_RNC_EMISOR=
DGII_RAZON_SOCIAL=
DGII_DIRECCION_EMISOR=
DGII_FECHA_VENCIMIENTO_SEC=31-12-2026
