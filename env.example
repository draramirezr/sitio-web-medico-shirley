#
# --- ZOHO MAIL (recomendado si el correo estÃ¡ en Zoho) ---
# Servidor SMTP:     smtp.zoho.com  (dominio org.: smtppro.zoho.com)
# Puerto TLS:        587  â EMAIL_USE_TLS=True,  EMAIL_USE_SSL=False
# Puerto SSL:        465  â EMAIL_USE_TLS=False, EMAIL_USE_SSL=True
# AutenticaciÃ³n:     SÃ­ (EMAIL_USERNAME + contraseÃ±a de aplicaciÃ³n Zoho)
#
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_USERNAME=info@draramirezr.com
EMAIL_PASSWORD=
